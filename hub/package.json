{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "_comment": "prebuild：在 build 前用 pnpm --dir 安装 ../web，供 vue-tsc 解析 ../web/src（否则 TS2307）；不随 install 执行，仅 dev 时需自行在 web 装依赖或先 build。若要与 web 的 pnpm-lock 严格一致可另行 pnpm install。packageManager：与 web 一致，便于 Corepack / CI。hub/public 下 PWA 用 PNG/ico 与 web/public 同名资源一致，为拷贝；更新主站图标后可从 web/public 再 cp 覆盖。",
  "scripts": {
    "dev": "vite",
    "generate:seo-assets": "node ./scripts/generate-seo-assets.mjs",
    "prebuild": "pnpm run generate:seo-assets && pnpm install --dir ../web",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "@unocss/preset-wind4": "^66.11.0",
    "@vueuse/core": "^15.0.0",
    "floating-vue": "^5.4.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "photoswipe": "^5.4.4",
    "sass-embedded": "^1.106.0",
    "unocss": "^66.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
